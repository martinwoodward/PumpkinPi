# Copy to .env, fill these values locally, and upload with deploy.py --env.
# Never commit the real .env or paste credentials into chat.
# Values are literal: no variable expansion, escapes, or inline comments.
# Enter your Wi-Fi network name and password between the quotes.
# Enter a minimally privileged GitHub billing token locally, never in chat.
# Blank values deliberately boot into blue-status setup demo, with no network.
WIFI_SSID=
WIFI_PASSWORD=
GITHUB_TOKEN=
